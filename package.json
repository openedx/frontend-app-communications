{
  "name": "@openedx/frontend-app-communications",
  "version": "1.0.0",
  "packageManager": "npm@11.12.1",
  "description": "Frontend app communications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openedx/frontend-app-communications.git"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "/dist"
  ],
  "workspaces": [
    "packages/*"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "browserslist": [
    "extends @edx/browserslist-config"
  ],
  "atlasTranslations": {
    "path": "translations/frontend-app-communications/src/i18n/messages",
    "dependencies": [
      "@openedx/frontend-base"
    ]
  },
  "scripts": {
    "build": "make build",
    "build:ci": "make build-ci",
    "build:packages": "make build-packages",
    "clean": "make clean",
    "clean:packages": "make clean-packages",
    "dev": "PORT=1984 PUBLIC_PATH=/communications openedx dev",
    "dev:packages": "make dev-packages",
    "dev:site": "make dev-site",
    "i18n_extract": "openedx formatjs extract",
    "lint": "openedx lint .",
    "lint:fix": "openedx lint --fix .",
    "prepack": "npm run clean && npm run build",
    "snapshot": "openedx test --updateSnapshot",
    "test": "TZ=UTC openedx test --coverage --passWithNoTests",
    "translations:pull": "openedx translations:pull",
    "watch:build": "nodemon --exec 'npm run build'"
  },
  "author": "Open edX",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/openedx/frontend-app-communications#readme",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/openedx/frontend-app-communications/issues"
  },
  "dependencies": {
    "@edx/openedx-atlas": "^0.6.0",
    "@edx/tinymce-language-selector": "1.1.0",
    "@fortawesome/fontawesome-svg-core": "1.2.36",
    "@fortawesome/free-brands-svg-icons": "5.15.4",
    "@fortawesome/free-regular-svg-icons": "5.15.4",
    "@fortawesome/free-solid-svg-icons": "5.15.4",
    "@fortawesome/react-fontawesome": "0.2.0",
    "@tinymce/tinymce-react": "3.14.0",
    "classnames": "2.3.2",
    "jquery": "3.6.1",
    "popper.js": "1.16.1",
    "prop-types": "15.8.1",
    "react-helmet": "^6.1.0",
    "tinymce": "5.10.7"
  },
  "peerDependencies": {
    "@openedx/frontend-base": "^1.0.1 || 0.0.0-dev",
    "@openedx/paragon": "^23.20.0 || 0.0.0-dev",
    "@tanstack/react-query": "^5.81.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^6.26.1",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@edx/browserslist-config": "^1.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "axios-mock-adapter": "1.21.2",
    "jest": "29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "2.8.1",
    "rosie": "2.1.0",
    "tsc-alias": "^1.9.8",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
